
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load Iris dataset
df = pd.read_csv("Iris.csv")

# Display dataset
print(df.head())

# 1. Line Plot
plt.figure(figsize=(8, 5))
plt.plot(df.index[:30], df["SepalLengthCm"][:30], marker="o")
plt.title("Sepal Length of First 30 Flowers")
plt.xlabel("Flower Index")
plt.ylabel("Sepal Length (cm)")
plt.show()

# 2. Bar Plot
avg = df.groupby("Species")["PetalLengthCm"].mean()

plt.figure(figsize=(8, 5))
plt.bar(avg.index, avg.values)
plt.title("Average Petal Length by Species")
plt.xlabel("Species")
plt.ylabel("Average Petal Length (cm)")
plt.show()

# 3. Scatter Plot
plt.figure(figsize=(8, 5))

for species in df["Species"].unique():
    data = df[df["Species"] == species]
    plt.scatter(data["SepalLengthCm"],
                data["PetalLengthCm"], label=species)

plt.title("Sepal Length vs Petal Length")
plt.xlabel("Sepal Length (cm)")
plt.ylabel("Petal Length (cm)")
plt.legend()
plt.show()

# 4. Correlation Matrix
numeric = df.select_dtypes(include="number").drop(
    columns=["Id"], errors="ignore"
)
corr = numeric.corr()

print("\nCorrelation Matrix:")
print(corr)

# 5. Heatmap
plt.figure(figsize=(8, 5))
sns.heatmap(corr, annot=True, cmap="coolwarm")
plt.title("Iris Dataset Correlation Heatmap")
plt.show()
